require "tmpdir"
require "securerandom"
require "open3"
require "fileutils"
require "plist"
require_relative "lib/signing_config"
require_relative "lib/signing_asset_verifier"
require_relative "lib/apple_api_diagnostics"
require_relative "lib/release_pipeline"
require_relative "lib/archive_diagnostics"

def project_path(*parts)
  File.join(File.expand_path("..", FastlaneCore::FastlaneFolder.path), *parts)
end

def required!(*names)
  missing = names.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Missing GitHub Secrets: #{missing.join(', ')}. See docs/RELEASING.md") unless missing.empty?
end

def command!(*args)
  stdout, _stderr, status = Open3.capture3(*args)
  UI.user_error!("Signing command failed: #{File.basename(args.first)} (details suppressed to protect signing data)") unless status.success?
  stdout
end

def api_key
  required!("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_API_KEY_P8")
  app_store_connect_api_key(**ChaiSigning.api_key_options(ENV))
rescue ArgumentError, KeyError
  UI.user_error!("[CHAI_SIGNING:APPLE_KEY] Invalid original ASC_API_KEY_P8 or missing API key fields")
end

def trusted_dispatch!
  UI.user_error!("Signing requires manual workflow_dispatch on main") unless
    ENV["GITHUB_EVENT_NAME"] == "workflow_dispatch" && ENV["GITHUB_REF"] == "refs/heads/main"
end

def verify_apple_access!
  client = ChaiAppleDiagnostics::Client.new(
    token_provider: -> { Spaceship::ConnectAPI.token.text },
    app_identifier: ChaiSigning::APP_IDENTIFIER
  )
  ChaiAppleDiagnostics.verify!(client: client, team_id: ENV.fetch("APPLE_TEAM_ID"))
rescue ChaiAppleDiagnostics::Failure
  # The Python wrapper publishes only validated status/resource/category fields.
  # No broad UnexpectedResponse -> permission-denied conversion remains.
  UI.user_error!("[CHAI_SIGNING:APPLE_DIAGNOSTIC] Read-only Apple API check failed; see safe diagnostic report")
end

def profile_files
  ChaiSigningAssets.roots.flat_map { |path| Dir.glob(File.join(path, "*.mobileprovision")) }
end

def parsed_profile(path)
  Plist.parse_xml(command!("security", "cms", "-D", "-i", path))
end

def asset_command!(code, *argv)
  output, ok = ChaiSigningAssets::Commands.new.run(*argv)
  raise ChaiSigningAssets::Failure.new(code) unless ok
  output
end

def with_match_signing(key = nil, readonly: true)
  trusted_dispatch!
  raise ChaiSigningAssets::Failure.new("ASSET_READONLY_REQUIRED") unless readonly == true
  required!("APPLE_TEAM_ID", "SIGNING_REPO_PAT", "MATCH_PASSWORD")
  Dir.mktmpdir("chai-match-") do |dir|
    keychain = File.join(dir, "signing.keychain-db")
    password = SecureRandom.hex(32)
    original = []
    previous_profiles = {}
    search_list_changed = false
    begin
      original = asset_command!("ASSET_KEYCHAIN_SETUP", "security", "list-keychains", "-d", "user").scan(/"([^"]+)"/).flatten
      previous_profiles = profile_files.to_h { |path| [path, File.binread(path)] }
      asset_command!("ASSET_KEYCHAIN_SETUP", "security", "create-keychain", "-p", password, keychain)
      asset_command!("ASSET_KEYCHAIN_SETUP", "security", "set-keychain-settings", "-lut", "21600", keychain)
      asset_command!("ASSET_KEYCHAIN_SETUP", "security", "unlock-keychain", "-p", password, keychain)
      asset_command!("ASSET_KEYCHAIN_SETUP", "security", "list-keychains", "-d", "user", "-s", keychain, *original)
      search_list_changed = true
      begin
        match(**ChaiSigning.match_options(ENV, api_key: key, keychain: keychain, password: password, readonly: true))
      rescue StandardError
        raise ChaiSigningAssets::Failure.new("ASSET_MATCH_READ")
      end
      mapping = Fastlane::Actions.lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING] || {}
      hints = ChaiSigningAssets.hints(env: ENV, mapping: mapping)
      verifier = ChaiSigningAssets::Verifier.new(team_id: ENV.fetch("APPLE_TEAM_ID"), keychain: keychain, hints: hints)
      result = verifier.check!
      ChaiSigningAssets.prepare_xcode_profile!(result)
      verifier.mark_xcode_ready!
      yield result.fetch(:profile).fetch("UUID"), result.fetch(:identity), keychain, result
    ensure
      # Local cleanup only for this app. Other apps (including ChaiPhoto) are not
      # selected/restored/removed; no Apple API or signing-repository writes occur.
      profile_files.each do |path|
        begin
          data = parsed_profile(path)
          next unless data.dig("Entitlements", "application-identifier").to_s.end_with?(".#{ChaiSigning::APP_IDENTIFIER}")
          previous_profiles.key?(path) ? File.binwrite(path, previous_profiles[path]) : FileUtils.rm_f(path)
        rescue StandardError
          # Leave unrecognized profiles alone on the ephemeral runner.
        end
      end
      Open3.capture3("security", "list-keychains", "-d", "user", "-s", *original) if search_list_changed
      Open3.capture3("security", "delete-keychain", keychain)
    end
  end
rescue ChaiSigningAssets::Failure => error
  UI.user_error!("[CHAI_SIGNING:#{error.code}] Local readonly signing asset verification failed; values suppressed")
end

def validated_version
  version = ENV.fetch("RELEASE_VERSION")
  UI.user_error!("RELEASE_VERSION must be three numeric components") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  version
end

def next_apple_build(key, version)
  # ASC provides authoritative monotonicity, also covers manual uploads outside GitHub.
  app = Spaceship::ConnectAPI::App.find("cc.chaihome.chaiclassics")
  UI.user_error!("Create App Store Connect App Record first") unless app
  builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, sort: "-uploadedDate", limit: 100)
  run = Integer(ENV.fetch("GITHUB_RUN_NUMBER"))
  attempt = Integer(ENV.fetch("GITHUB_RUN_ATTEMPT"))
  UI.user_error!("Build counter capacity exceeded; establish an explicit versioned counter migration") unless (1..9999).cover?(run) && (1..99).cover?(attempt)
  candidate = [run, 0, attempt]
  existing = builds.map { |build| (build.version.to_s.split(".").map(&:to_i) + [0, 0]).first(3) }
  UI.user_error!("Refusing to reuse or decrease an Apple build number. Dispatch a NEW TestFlight run rather than retrying an older run; check any manual Apple uploads.") if existing.any? { |number| (number <=> candidate) >= 0 }
  candidate.join(".")
end

default_platform(:ios)
platform :ios do
  desc "Read-only Apple certificate/profile/Bundle ID diagnostics; never calls match"
  lane :diagnose_signing do
    trusted_dispatch!
    required!("APPLE_TEAM_ID")
    api_key
    # Access .text exactly once: both endpoints receive this same JWT snapshot.
    token = Spaceship::ConnectAPI.token.text
    passed = ChaiAppleDiagnostics.compare_authentication!(
      token: token, key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      verification_key: OpenSSL::PKey.read(ENV.fetch("ASC_API_KEY_P8"))
    )
    UI.user_error!("[CHAI_SIGNING:APPLE_DIAGNOSTIC] Read-only JWT/API comparison did not pass") unless passed
  end

  desc "Reuse existing encrypted signing assets; initialization is locked to readonly"
  lane :initialize_signing do
    trusted_dispatch!
    required!("APPLE_TEAM_ID", "SIGNING_REPO_PAT", "MATCH_PASSWORD")
    key = api_key
    verify_apple_access!
    with_match_signing(key, readonly: true) do |_profile_uuid, _identity, _keychain|
      UI.success("Existing appstore signing assets verified in readonly mode")
    end
  end

  desc "Verify existing encrypted signing assets and real private-key signing; no Apple API or upload"
  lane :verify_signing_assets do
    trusted_dispatch!
    required!("APPLE_TEAM_ID", "SIGNING_REPO_PAT", "MATCH_PASSWORD")
    with_match_signing(nil, readonly: true) do |_profile_uuid, _identity, _keychain|
      UI.success("Readonly signing asset pairing and local signature verified")
    end
  end

  desc "Diagnose a real signed iOS Release archive with readonly assets; never export or upload"
  lane :diagnose_signed_archive do
    trusted_dispatch!
    required!("APPLE_TEAM_ID", "SIGNING_REPO_PAT", "MATCH_PASSWORD")
    version = validated_version
    run = Integer(ENV.fetch('GITHUB_RUN_NUMBER'))
    attempt = Integer(ENV.fetch('GITHUB_RUN_ATTEMPT'))
    UI.user_error!('[CHAI_SIGNING:BUILD_CONFIG] Invalid local diagnostic build counter') unless (1..9999).cover?(run) && (1..99).cover?(attempt)
    with_match_signing(nil, readonly: true) do |profile_uuid, identity, keychain, assets|
      options = ChaiRelease.build_options(root: project_path, version: version, number: "#{run}.0.#{attempt}",
        team: ENV.fetch('APPLE_TEAM_ID'), profile_uuid: profile_uuid, identity: identity,
        certificate: assets.fetch(:certificate), keychain: keychain)
      ChaiRelease.validate_options!(ChaiRelease.archive_options(options))
      Fastlane::Actions.lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING] = { ChaiSigning::APP_IDENTIFIER => profile_uuid }
      ChaiArchive::Session.new.run!(options: options, assets: assets) { |params| build_app(**params) }
    end
  end

  desc "Signed archive and manual TestFlight upload; never triggered by push"
  lane :beta do
    trusted_dispatch!
    release = ChaiRelease::Report.new
    version, key, number = release.run('UPLOAD_AUTH') do
      selected_version = validated_version
      # Developer key only: ASC app/build reads, no certificate/profile portal API.
      selected_key = api_key
      [selected_version, selected_key, next_apple_build(selected_key, selected_version)]
    end
    with_match_signing(key, readonly: true) do |profile_uuid, identity, keychain, assets|
      options = release.run('BUILD_CONFIG') do
        config = ChaiRelease.build_options(root: project_path, version: version, number: number,
          team: ENV.fetch('APPLE_TEAM_ID'), profile_uuid: profile_uuid, identity: identity,
          certificate: assets.fetch(:certificate), keychain: keychain)
        ChaiRelease.validate_options!(ChaiRelease.archive_options(config))
        ChaiRelease.validate_options!(ChaiRelease.export_options(config))
        config
      end
      # Keep build_app's match mapping merge pinned to the profile just verified.
      Fastlane::Actions.lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING] = { ChaiSigning::APP_IDENTIFIER => profile_uuid }
      release.run('ARCHIVE') do
        ChaiArchive::Session.new.run!(options: options, assets: assets) { |params| build_app(**params) }
      end
      ipa = release.run('EXPORT_IPA') do
        output = build_app(**ChaiRelease.export_options(options))
        verified = ChaiRelease.verify_ipa!(output, expected: File.join(options.fetch(:output_directory), 'ChaiClassics.ipa'))
        FileUtils.mkdir_p(project_path('build','release'))
        File.write(project_path("build", "release", "provenance.txt"), "version=#{version}\nbuild=#{number}\ncommit=#{ENV.fetch('GITHUB_SHA')}\n")
        verified
      end
      release.run('UPLOAD_TRANSFER') do
        notes = "Commit #{ENV.fetch('GITHUB_SHA')} | run #{ENV.fetch('GITHUB_RUN_ID')}, attempt #{ENV.fetch('GITHUB_RUN_ATTEMPT')}"
        upload_to_testflight(api_key: key, app_identifier: "cc.chaihome.chaiclassics", ipa: ipa, changelog: notes, skip_waiting_for_build_processing: true)
      end
    end
  end

  desc "Select an iPhone-tested TestFlight build and prepare metadata, without submission or public release"
  lane :prepare_store do
    trusted_dispatch!
    version = validated_version
    key = api_key
    required!("TESTED_BUILD_NUMBER", "RELEASE_NOTES", "TESTED_COMMIT")
    UI.user_error!("Selected build must come from the current reviewed main commit") unless ENV.fetch("TESTED_COMMIT") == ENV.fetch("GITHUB_SHA")
    # Merchant supplies and reviews real metadata/screenshots directly in ASC.
    # Only upload this version's release notes and select an already-tested build.
    Dir.mktmpdir("chai-metadata-") do |metadata|
      FileUtils.mkdir_p(File.join(metadata, "zh-Hant"))
      File.write(File.join(metadata, "zh-Hant", "release_notes.txt"), ENV.fetch("RELEASE_NOTES"))
      deliver(api_key: key, app_identifier: "cc.chaihome.chaiclassics", app_version: version, build_number: ENV.fetch("TESTED_BUILD_NUMBER"),
        metadata_path: metadata, skip_screenshots: true, skip_binary_upload: true,
        submit_for_review: false, automatic_release: false, force: true, run_precheck_before_submit: false)
    end
  end
end
